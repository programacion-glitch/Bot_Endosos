{
  "name": "bot-h2o",
  "version": "1.0.0",
  "description": "H2O Insurance Agency - Automated Bot for NowCerts via Playwright",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "web": "node dist/web/server.js",
    "web:dev": "ts-node-dev --respawn --transpile-only src/web/server.ts",
    "seed-user": "ts-node src/web/seedUser.ts"
  },
  "dependencies": {
    "@playwright/test": "1.58.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.9",
    "playwright": "1.58.2",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/imap-simple": "^4.2.3",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
